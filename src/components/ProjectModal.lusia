<script>
  import StarCount from "./StarCount.lusia";
  import { EASE, ON, onDetach, props, variable, type Keyframes } from "lusiajs";
  import ProjectSlider from "./ProjectSlider.lusia";
  import { motion } from "../motion.ts";
  import { labelFor } from "../data/featured.ts";

  type ModalProject = {
    name: string;
    description: string;
    lang: string;
    stars: number | null;
    url: string;
    images: string[];
    fit?: "cover" | "contain";
    features: string[];
    links: { label: string; url: string }[];
  };

  const { project, open } = props(class {
    project: ModalProject | null = null;
    open = false;
  });

  const fadeIn: Keyframes = { 0: { opacity: 0 }, 1: { opacity: 1 } };
  const fadeOut: Keyframes = { 0: { opacity: 1 }, 1: { opacity: 0 } };
  const panelIn: Keyframes = {
    0: { opacity: 0, scale: "0.96", translate: "0px 12px" },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, scale: "1", translate: "0px 0px" }],
  };
  const panelOut: Keyframes = {
    0: { opacity: 1, scale: "1", translate: "0px 0px" },
    1: [EASE.STYLE.QUART, EASE.IN, { opacity: 0, scale: "0.96", translate: "0px 12px" }],
  };

  const dialogEl = variable<HTMLElement | null>(null);

  function focusCard(name: string) {
    document.querySelector<HTMLElement>(`[data-project-card="${CSS.escape(name)}"]`)?.focus();
  }

  function close() {
    const name = project?.name;
    open = false;
    if (name) focusCard(name);
  }

  function focusables(): HTMLElement[] {
    return [...(dialogEl.value?.querySelectorAll<HTMLElement>("button, a[href], [tabindex='0']") ?? [])];
  }

  function trapFocus(event: KeyboardEvent) {
    const items = focusables();
    const first = items[0];
    const last = items.at(-1);
    if (!first || !last) return;
    const active = document.activeElement;
    if (event.shiftKey && (active === first || active === dialogEl.value)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function onKey(event: KeyboardEvent) {
    if (event.key === "Escape") close();
    else if (event.key === "Tab") trapFocus(event);
    else return;
    event.preventDefault();
  }

  function onBackdrop(event: MouseEvent) {
    if (event.target === event.currentTarget) close();
  }

  function stopWheel(event: WheelEvent) {
    event.stopPropagation();
  }

  function focusDialog() {
    window.setTimeout(() => dialogEl.value?.focus(), 0);
  }

  variable.autoRun(() => {
    document.body.style.overflow = open ? "hidden" : "";
    if (open) focusDialog();
  });

  onDetach(() => {
    document.body.style.overflow = "";
  });
</script>

<IF {open}>
  <div class="overlay" data-prevent-page-scroll on:wheel={stopWheel} onclick={onBackdrop} onkeydown={onKey}
    animate={motion([
      { play: fadeIn, on: ON.ATTACH, duration: 280 },
      { play: fadeOut, on: ON.DETACH, duration: 200 },
    ])}>
    <IF {project !== null}>
      <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="project-modal-title" tabindex="-1" bind-element={dialogEl}
        animate={motion([
          { play: panelIn, on: ON.ATTACH, duration: 280 },
          { play: panelOut, on: ON.DETACH, duration: 200 },
        ])}>
        <button class="close" type="button" aria-label="Close" onclick={close}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
        </button>

        <div class="scroll" data-prevent-page-scroll>
          <ProjectSlider images={project.images} title={project.name} logo={project.fit === "contain"} />

          <div class="info">
            <h2 id="project-modal-title" class="title notranslate" translate="no">{project.name}</h2>
            <p class="meta label">
              <span class="notranslate" translate="no">{project.lang}</span>
              <IF {project.stars !== null}>
                <StarCount count={project.stars} />
              </IF>
            </p>
            <p class="desc">{project.description}</p>

            <IF {project.features.length > 0}>
              <div class="features">
                <h3 class="label">Main content</h3>
                <ul>
                  <EACH {project.features} as={feature} key={feature}>
                    <li><span aria-hidden="true">○</span><span>{feature}</span></li>
                  </EACH>
                </ul>
              </div>
            </IF>

            <div class="footer">
              <EACH {project.links} as={link} key={link.url}>
                <a class="btn" href={link.url} target="_blank" rel="noopener">{link.label}</a>
              </EACH>
              <a class="btn" href={project.url} target="_blank" rel="noopener">{labelFor(project.url)}</a>
            </div>
          </div>
        </div>
      </div>
    </IF>
  </div>
</IF>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    padding: 24px;
    box-sizing: border-box;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(880px, 100%);
    max-height: 85svh;
    box-sizing: border-box;
    border: 1.5px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
    color: var(--fg);
    overflow: hidden;
  }

  .dialog:focus {
    outline: none;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }

  .close svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .scroll {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 0;
    padding: 24px 28px 28px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .title {
    margin: 0;
    font-size: clamp(1.6rem, 3.6vh, 2.2rem);
    line-height: 1.1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 6px;
  }

  .desc {
    margin: 0;
    color: var(--muted);
  }

  .features h3 {
    margin: 0 0 8px;
    opacity: 0.6;
  }

  .features ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    display: flex;
    gap: 10px;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn {
    padding: 8px 16px;
    border: 1.5px solid var(--fg);
    border-radius: 999px;
    color: var(--fg);
    font: 600 12px/1.2 var(--mono);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @include screen(PHONE) {
    .overlay {
      padding: 12px;
    }

    .scroll {
      padding: 20px;
    }
  }
</style>
