<script>
  import { onAttach, props, variable } from "lusiajs";
  import NoPreview from "./NoPreview.lusia";

  const { images, title, auto, logo } = props(class {
    images: string[] = [];
    title = "";
    auto = false;
    logo = false;
  });

  const HOLD_MS = 8000;
  const CYCLE_MS = 4000;

  const slides = images.map((src, index) => ({ src, index, video: src.includes("youtube") }));
  const current = variable(0);
  const paused = variable(false);
  const imgClass = logo ? "logo" : "";
  let holdUntil = 0;

  function advance(delta: number) {
    const total = slides.length;
    current.value = (current.value + delta + total) % total;
  }

  function hold() {
    holdUntil = Date.now() + HOLD_MS;
  }

  function step(delta: number) {
    hold();
    advance(delta);
  }

  function go(index: number) {
    hold();
    current.value = index;
  }

  function onKey(event: KeyboardEvent) {
    if (event.key === "ArrowLeft") step(-1);
    else if (event.key === "ArrowRight") step(1);
    else return;
    event.preventDefault();
  }

  function slideClass(index: number): string {
    return current.value === index ? "slide on" : "slide";
  }

  function dotClass(index: number): string {
    return current.value === index ? "dot on" : "dot";
  }

  onAttach(() => {
    if (!auto) return;
    const timer = window.setInterval(() => {
      if (paused.value || Date.now() < holdUntil || slides.length < 2) return;
      advance(1);
    }, CYCLE_MS);
    return () => window.clearInterval(timer);
  });
</script>

<div class="slider" tabindex="0" role="region" aria-roledescription="carousel" aria-label="{title} screenshots" onkeydown={onKey} on:mouseenter={() => (paused.value = true)} on:mouseleave={() => (paused.value = false)}>
  <IF {slides.length > 0}>
    <div class="stage">
      <EACH {slides} as={slide} key={slide.index}>
        <div class={slideClass(slide.index)}>
          <IF {slide.video}>
            <iframe src={slide.src} title="{title} demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          <ELSE>
            <img class={imgClass} src={slide.src} alt="{title} screenshot {slide.index + 1}" loading="lazy" decoding="async" />
          </IF>
        </div>
      </EACH>
    </div>

    <IF {slides.length > 1}>
      <button class="nav prev" type="button" aria-label="Previous image" onclick={() => step(-1)}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button class="nav next" type="button" aria-label="Next image" onclick={() => step(1)}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
      </button>
      <div class="dots">
        <EACH {slides} as={slide} key={slide.index}>
          <button class={dotClass(slide.index)} type="button" aria-label="Image {slide.index + 1} of {slides.length}" onclick={() => go(slide.index)}></button>
        </EACH>
      </div>
    </IF>
  <ELSE>
    <NoPreview />
  </IF>
</div>

<style>
  .slider {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 50svh;
    overflow: hidden;
    border-radius: 16px;
    border: 1.5px solid var(--line);
    background: var(--bg);
  }

  .slider:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 280ms ease, transform 280ms ease;
    pointer-events: none;
  }

  .slide.on {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .slide img,
  .slide iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: contain;
  }

  .slide img.logo {
    box-sizing: border-box;
    padding: 16%;
    object-fit: contain;
  }

  .nav {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 150ms ease;
  }

  .nav.prev {
    left: 12px;
  }

  .nav.next {
    right: 12px;
  }

  .nav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav:focus-visible {
    opacity: 1;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .slider:hover .nav,
    .slider:focus-within .nav {
      opacity: 1;
    }
  }

  @media (hover: none) {
    .nav {
      opacity: 1;
    }
  }

  .dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    z-index: 1;
    display: flex;
    gap: 6px;
    transform: translateX(-50%);
  }

  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: width 200ms ease, background-color 200ms ease;
  }

  .dot.on {
    width: 22px;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .nav,
    .dot {
      transition: none;
    }

    .slide {
      transform: none;
    }
  }
</style>
