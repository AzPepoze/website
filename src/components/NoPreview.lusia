    overflow: hidden;
    container-type: inline-size;
    background-color: var(--bg);
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 8px 8px;
    color: var(--muted);
    text-align: center;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 4px;
    min-width: 0;
  }

  .icon {
    display: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
