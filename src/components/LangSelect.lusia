<script>
  import { EASE, EVENT, ON, listen, onAttach, variable, type Keyframes } from "lusiajs";
  import { LANGUAGES, readLanguage, setLanguage, shortCode, startTranslate, type LangCode } from "../translate.ts";
  import { motion } from "../motion.ts";

  const menuIn: Keyframes = {
    0: { opacity: 0, translate: "0px 12px", scale: "0.92" },
    1: [EASE.STYLE.BACK, EASE.OUT, { opacity: 1, translate: "0px 0px", scale: "1" }],
  };
  const optionIn: Keyframes = {
    0: { opacity: 0, translate: "0px 10px" },
    1: [EASE.STYLE.CUBIC, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
  };
  const OPTION_STAGGER = 28;

  function optionMotion(index: number) {
    return motion({ play: optionIn, on: ON.ATTACH, duration: 260, delay: 40 + index * OPTION_STAGGER });
  }

  const menuOut: Keyframes = {
    0: { opacity: 1, translate: "0px 0px", scale: "1" },
    1: { opacity: 0, translate: "0px 12px", scale: "0.92" },
  };
  const codes: string[] = LANGUAGES.map((language) => language.code);

  const open = variable(false);
  const current = variable<LangCode>(readLanguage());
  const wrap = variable<HTMLElement | null>(null);
  const buttonEl = variable<HTMLButtonElement | null>(null);

  const buttonCode = variable.compute(() => shortCode(current.value));
  const currentName = variable.compute(() => LANGUAGES.find((language) => language.code === current.value)?.name ?? "English");
  const label = variable.compute(() => `Change language, current ${currentName.value}`);

  function optionEl(code: string): HTMLElement | null {
    return document.getElementById(`lang-${code}`);
  }

  function focusOption(code: string) {
    window.setTimeout(() => optionEl(code)?.focus(), 0);
  }

  function openMenu(focus: boolean) {
    open.value = true;
    if (focus) focusOption(current.value);
  }

  function closeMenu(restoreFocus: boolean) {
    open.value = false;
    if (restoreFocus) buttonEl.value?.focus();
  }

  function toggleMenu() {
    if (open.value) closeMenu(false);
    else openMenu(false);
  }

  function choose(code: LangCode) {
    current.value = code;
    closeMenu(true);
    setLanguage(code).catch((error: unknown) => console.warn("Language change failed", error));
  }

  function moveFocus(delta: number) {
    const active = document.activeElement?.id.replace("lang-", "") ?? "";
    const index = Math.max(0, codes.indexOf(active));
    const next = (index + delta + codes.length) % codes.length;
    optionEl(codes[next])?.focus();
  }

  function onButtonKey(event: KeyboardEvent) {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
    event.preventDefault();
    openMenu(true);
  }

  function onMenuKey(event: KeyboardEvent) {
    if (event.key === "ArrowDown") moveFocus(1);
    else if (event.key === "ArrowUp") moveFocus(-1);
    else if (event.key === "Home") optionEl(codes[0])?.focus();
    else if (event.key === "End") optionEl(codes[codes.length - 1])?.focus();
    else if (event.key === "Escape") closeMenu(true);
    else if (event.key === "Tab") closeMenu(false);
    else return;
    event.preventDefault();
  }

  function onOptionKey(event: KeyboardEvent, code: LangCode) {
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    choose(code);
  }

  function optionClass(code: LangCode): string {
    return current.value === code ? "option on" : "option";
  }

  function optionSelected(code: LangCode): string {
    return current.value === code ? "true" : "false";
  }

  onAttach(() => {
    startTranslate();
    const element = wrap.value;
    if (!element) return;
    listen(element, EVENT.CLICK_OUTSIDE, (press: Event) => {
      if (press instanceof KeyboardEvent || !open.value) return;
      closeMenu(false);
    });
  });
</script>

<div id="google_translate_element" aria-hidden="true"></div>

<div class="lang-select notranslate" translate="no" bind-element={wrap}>
  <IF {open}>
    <ul
      class="menu"
      role="listbox"
      aria-label="Language"
      onkeydown={onMenuKey}
      animate={motion([
        { play: menuIn, on: ON.ATTACH, duration: 240 },
        { play: menuOut, on: ON.DETACH, duration: 160 },
      ])}
    >
      <EACH {LANGUAGES} as={language} index={i} key={language.code}>
        <li
          id="lang-{language.code}"
          class={optionClass(language.code)}
          role="option"
          tabindex="-1"
          aria-selected={optionSelected(language.code)}
          onclick={() => choose(language.code)}
          onkeydown={(event) => onOptionKey(event, language.code)}
          animate={optionMotion(i.value)}
        >
          <span>{language.name}</span>
          <span class="option-code">{shortCode(language.code)}</span>
        </li>
      </EACH>
      <li class="credit" role="presentation" animate={optionMotion(LANGUAGES.length)}>
        Powered by <a href="https://translate.google.com" target="_blank" rel="noopener">Google Translate</a>
      </li>
    </ul>
  </IF>

  <button
    class="toggle"
    type="button"
    bind-element={buttonEl}
    aria-haspopup="listbox"
    aria-expanded={open.value ? "true" : "false"}
    aria-label={label.value}
    onclick={toggleMenu}
    onkeydown={onButtonKey}
  >
    <svg class="globe" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
    </svg>
    <span class="code">{buttonCode}</span>
  </button>
</div>

<style global>
  #google_translate_element {
    position: fixed;
    left: -9999px;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    visibility: hidden;
    user-select: none;
  }

  body {
    top: 0 !important;
  }

  .goog-te-banner-frame,
  iframe.skiptranslate,
  #goog-gt-tt,
  #goog-gt-vt,
  .goog-te-balloon-frame,
  .goog-tooltip,
  .goog-tooltip:hover {
    display: none !important;
  }

  .goog-text-highlight {
    background: none !important;
    box-shadow: none !important;
  }
</style>

<style>
  .lang-select {
    position: fixed;
    right: 84px;
    bottom: 20px;
    z-index: 100;
  }

  .toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }

  .globe {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .code {
    font: 700 9px/1 var(--mono);
    letter-spacing: 0.06em;
  }

  .menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    display: grid;
    gap: 2px;
    min-width: 168px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .credit {
    margin-top: 4px;
    padding: 8px 12px 4px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--muted);
  }

  .credit a {
    color: var(--fg);
  }

  .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 12px;
    border-radius: 10px;
    font: 600 14px/1.2 var(--body);
    cursor: pointer;
    outline: none;
  }

  .option:hover,
  .option:focus-visible {
    background: var(--line);
  }

  .option.on {
    background: var(--fg);
    color: var(--bg);
  }

  .option-code {
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  @include screen(PHONE) {
    .lang-select {
      right: 24px;
      bottom: 80px;
    }
  }
</style>
