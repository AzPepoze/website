<script>
  import { EASE, EVENT, ON, listen, onAttach, variable, type Keyframes } from "lusiajs";
  import SectionHead from "../components/SectionHead.lusia";
  import Panel from "../components/Panel.lusia";
  import Heatmap from "../components/Heatmap.lusia";
  import RecentWork from "../components/RecentWork.lusia";
  import { fromLeft, fromRight, glowOn, listItem, motion, reduced } from "../motion.ts";

  type Calendar = { start: string; weeks: number[][]; counts: number[][] };
  type Stats = {
    repos: number;
    stars: number;
    contributions: number;
    followers: number;
    since: number;
    updated: string;
    calendar?: Calendar | null;
  };
  type Status = "loading" | "ready" | "error";

  const DURATION = 1200;
  const STATS_URL = "/stats.json";
  const GITHUB_URL = "https://github.com/AzPepoze";
  const INTRO =
    "I chase the goal, not the method. When I wanted YouTube to look cooler, I built NewTube, and learned web development on the way. Most of what's here started like that.";

  const tiles = [
    { id: "repos", label: "Public repos", suffix: "" },
    { id: "stars", label: "Stars earned", suffix: "" },
    { id: "contributions", label: "Contributions in the last year", suffix: "" },
    { id: "years", label: "Years on GitHub", suffix: "+" },
  ].map((tile, index) => ({ ...tile, index }));

  const tilePop: Keyframes = {
    0: { scale: "1 1" },
    0.5: [EASE.STYLE.BACK, EASE.OUT, { scale: "1.04 1.04" }],
    1: { scale: "1 1" },
  };
  const valuePop = motion({ play: tilePop, on: ON.HOVER, duration: 260 });

  const status = variable<Status>("loading");
  const sourceLine = variable("Live from GitHub");
  const shown = variable<Record<string, string>>({});
  const subs = variable<Record<string, string>>({});
  const calendar = variable<Calendar | null>(null);

  let targets: Record<string, number> = {};
  let inView = false;
  let frame = 0;

  function format(value: number, suffix: string) {
    return `${Math.round(value).toLocaleString("en-US")}${suffix}`;
  }

  function setShown(ratio: number) {
    const next: Record<string, string> = {};
    for (const tile of tiles) next[tile.id] = format(targets[tile.id] * ratio, tile.suffix);
    shown.value = next;
  }

  function countUp() {
    cancelAnimationFrame(frame);
    if (status.peek() !== "ready") return;
    if (reduced) return setShown(1);
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - start) / DURATION));
      setShown(1 - (1 - t) ** 3);
      if (t < 1) frame = requestAnimationFrame(step);
    };
    setShown(0);
    frame = requestAnimationFrame(step);
  }

  function resetCount() {
    cancelAnimationFrame(frame);
    if (!reduced) setShown(0);
  }

  function showStats(data: Stats) {
    targets = {
      repos: data.repos,
      stars: data.stars,
      contributions: data.contributions,
      years: new Date().getFullYear() - data.since,
    };
    subs.value = { years: `since ${data.since}` };
    const month = new Date(data.updated).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
    sourceLine.value = `Live from GitHub · updated ${month}`;
    calendar.value = data.calendar ?? null;
    status.value = "ready";
    if (inView) countUp();
    else setShown(reduced ? 1 : 0);
  }

  onAttach((root) => {
    const section = root.querySelector<HTMLElement>("#about")!;
    const stopGlow = glowOn(section, ".cell");
    const stop = listen(section, EVENT.VIEW, ({ in: visible }: { in: boolean }) => {
      inView = visible;
      if (visible) countUp();
      else resetCount();
    });

    fetch(STATS_URL)
      .then((res) => {
        if (!res.ok) throw new Error(`${STATS_URL} responded ${res.status}`);
        return res.json() as Promise<Stats>;
      })
      .then(showStats)
      .catch(() => (status.value = "error"));

    return () => {
      stop();
      stopGlow();
      cancelAnimationFrame(frame);
    };
  });
</script>

<section id="about" class="section">
  <div class="wrap">
    <SectionHead title="About" />

    <p class="intro" animate={motion(fromLeft)}>{INTRO}</p>

    <IF {status.value !== "error"}>
      <div class="grid">
        <EACH {tiles} as={tile} key={tile.id}>
          <div class="cell" animate={motion(listItem("left", tile.index, { step: 50 }))}>
            <Panel>
              <p class="stat-value" animate={valuePop}>{shown.value[tile.id] ?? "--"}</p>
              <p class="stat-label">{tile.label}</p>
              <p class="stat-sub label">{subs.value[tile.id] ?? ""}</p>
            </Panel>
          </div>
        </EACH>
      </div>
    </IF>

    <IF {calendar.value !== null}>
      <div class="block" animate={motion(fromRight)}>
        <p class="label">Contributions in the last year</p>
        <Heatmap calendar={calendar.value} />
      </div>
    </IF>

    <div class="block">
      <RecentWork />
    </div>

    <p class="source label">
      {sourceLine.value} · <a href={GITHUB_URL} target="_blank" rel="noopener">github.com/AzPepoze</a>
    </p>
  </div>
</section>

<style global>
  #about .grid .panel {
    position: relative;
    overflow: hidden;
    padding: 14px 18px;
  }

  #about .grid .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(180px circle at var(--x, 50%) var(--y, 50%), color-mix(in srgb, var(--fg) 14%, transparent), transparent 70%);
  }

  #about .cell:hover .panel {
    border-color: color-mix(in srgb, var(--fg) 40%, transparent);
  }

  #about .cell:hover .panel::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    #about .grid .panel,
    #about .grid .panel::before {
      transition: border-color 200ms ease, opacity 200ms ease;
    }
  }
</style>

<style>
  #about {
    padding-top: clamp(56px, 9vh, 96px);
    padding-bottom: calc(var(--dock-h) + 24px);
  }

  .intro {
    max-width: 640px;
    margin: 0 0 clamp(10px, 2vh, 20px);
    font-size: clamp(18px, 2.6vh, 20px);
    line-height: 1.5;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .cell {
    display: flex;
  }

  .cell > * {
    flex: 1;
    min-width: 0;
  }

  .stat-value {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.75rem, 5vh, 2.75rem);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .stat-sub {
    margin: 2px 0 0;
    min-height: 1.4em;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: clamp(12px, 2vh, 20px);
  }

  .source {
    margin: clamp(10px, 2vh, 16px) 0 0;
  }

  .source a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @include screen(PHONE) {
    #about {
      padding-top: 64px;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .intro {
      font-size: 18px;
      margin-bottom: 14px;
    }

    .stat-value {
      font-size: 1.75rem;
    }

    .stat-sub {
      display: none;
    }
  }
</style>
